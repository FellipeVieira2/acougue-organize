# Pooled PostgreSQL URL for a restricted service login with membership in acougue_runtime.
DATABASE_URL=
# Migration owner connection, used only by the manual migration command, not Vercel.
DATABASE_MIGRATION_URL=
# Exact public origin, for example https://your-project.vercel.app
APP_URL=http://localhost:3000
# Explicitly opt in to public registration during the pilot.
ALLOW_SIGNUP=false
