{
  "name": "acougue-organize",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "test": "node --test packages/domain/test/*.test.ts",
    "test:integration": "node --test packages/domain/test/database.integration.ts",
    "test:http": "node --test packages/domain/test/http.integration.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swr": "^2.5.1"
  }
}
